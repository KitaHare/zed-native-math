+use std::mem;
+use std::ops::Range;
+use std::rc::Rc;
+
+use unicode_segmentation::UnicodeSegmentation;
+
+use crate::katex::{
+    KatexRenderMode, KatexState, cache_contents_for_rendered_formula, render_display_katex_diagram,
+    render_inline_katex_diagram,
+};
+
+use super::*;
+
+pub(super) fn heading_text_style(
+    level: pulldown_cmark::HeadingLevel,
+    custom_styles: Option<&HeadingLevelStyles>,
+) -> TextStyleRefinement {
+    let mut text_style = match level {
+        pulldown_cmark::HeadingLevel::H1 => TextStyleRefinement {
+            font_size: Some(rems(1.875).into()),
+            ..Default::default()
+        },
+        pulldown_cmark::HeadingLevel::H2 => TextStyleRefinement {
+            font_size: Some(rems(1.5).into()),
+            ..Default::default()
+        },
+        pulldown_cmark::HeadingLevel::H3 => TextStyleRefinement {
+            font_size: Some(rems(1.25).into()),
+            ..Default::default()
+        },
+        pulldown_cmark::HeadingLevel::H4 => TextStyleRefinement {
+            font_size: Some(rems(1.125).into()),
+            ..Default::default()
+        },
+        pulldown_cmark::HeadingLevel::H5 => TextStyleRefinement {
+            font_size: Some(rems(1.0).into()),
+            ..Default::default()
+        },
+        pulldown_cmark::HeadingLevel::H6 => TextStyleRefinement {
+            font_size: Some(rems(0.875).into()),
+            ..Default::default()
+        },
+    };
+
+    if let Some(styles) = custom_styles {
+        let style_opt = match level {
+            pulldown_cmark::HeadingLevel::H1 => &styles.h1,
+            pulldown_cmark::HeadingLevel::H2 => &styles.h2,
+            pulldown_cmark::HeadingLevel::H3 => &styles.h3,
+            pulldown_cmark::HeadingLevel::H4 => &styles.h4,
+            pulldown_cmark::HeadingLevel::H5 => &styles.h5,
+            pulldown_cmark::HeadingLevel::H6 => &styles.h6,
+        };
+
+        if let Some(style) = style_opt {
+            text_style.refine(style);
+        }
+    }
+
+    text_style
+}
+
+pub(super) fn push_math_event(
+    markdown: &Entity<Markdown>,
+    parsed_markdown: &ParsedMarkdown,
+    render_diagrams: bool,
+    katex_state: &KatexState,
+    range: &Range<usize>,
+    builder: &mut MarkdownElementBuilder,
+    window: &mut Window,
+    cx: &mut App,
+) {
+    if render_diagrams
+        && let Some(katex_diagram) = parsed_markdown.katex_diagrams.get(&range.start)
+    {
+        let contents = cache_contents_for_rendered_formula(
+            katex_diagram,
+            f32::from(builder.text_style().font_size.to_pixels(window.rem_size())),
+            builder.text_style().color,
+        );
+        let source_range = katex_diagram.source_range.clone();
+        let source = &parsed_markdown.source[source_range.clone()];
+        if katex_state.should_show_source_text_for_contents(&contents) {
+            markdown.update(cx, |markdown, cx| {
+                markdown.katex_state.ensure_cached_contents(
+                    katex_diagram.source_range.start,
+                    &contents,
+                    cx,
+                );
+            });
+            match katex_diagram.mode {
+                KatexRenderMode::Inline => builder.push_text(source, source_range),
+                KatexRenderMode::Display => builder.push_block_text(source, source_range),
+            }
+        } else {
+            match katex_diagram.mode {
+                KatexRenderMode::Inline => builder.push_inline_sourced_element(
+                    source_range,
+                    render_inline_katex_diagram(katex_state, &contents, source),
+                ),
+                KatexRenderMode::Display => builder.push_block_sourced_element(
+                    source_range,
+                    render_display_katex_diagram(katex_state, &contents, source),
+                ),
+            }
+        }
+    } else {
+        builder.push_text(&parsed_markdown.source[range.clone()], range.clone());
+    }
+}
+
+fn opens_inline_group(character: char) -> bool {
+    matches!(
+        character,
+        '(' | '[' | '{' | '（' | '【' | '「' | '『' | '《' | '〈' | '“' | '‘'
+    )
+}
+
+fn closes_inline_group(character: char) -> bool {
+    matches!(
+        character,
+        ')' | ']'
+            | '}'
+            | '）'
+            | '】'
+            | '」'
+            | '』'
+            | '》'
+            | '〉'
+            | '”'
+            | '’'
+            | ','
+            | '.'
+            | ':'
+            | ';'
+            | '!'
+            | '?'
+            | '，'
+            | '。'
+            | '：'
+            | '；'
+            | '！'
+            | '？'
+            | '、'
+    )
+}
+
+fn inline_text_ranges(text: &str) -> Vec<Range<usize>> {
+    let mut ranges: Vec<Range<usize>> = Vec::new();
+    let mut start = 0;
+    for (index, word) in text.split_word_bound_indices() {
+        let end = index + word.len();
+        if word.chars().all(opens_inline_group) {
+            continue;
+        }
+        if start == index
+            && word != "\n"
+            && word
+                .chars()
+                .all(|character| character.is_whitespace() || closes_inline_group(character))
+            && let Some(previous) = ranges.last_mut()
+            && &text[previous.clone()] != "\n"
+        {
+            previous.end = end;
+        } else {
+            ranges.push(start..end);
+        }
+        start = end;
+    }
+    if start < text.len() {
+        ranges.push(start..text.len());
+    }
+    ranges
+}
+
+impl PendingLine {
+    pub(super) fn slice(&self, range: Range<usize>) -> Self {
+        let mut runs = Vec::new();
+        let mut offset = 0;
+        for run in &self.runs {
+            let end = offset + run.len;
+            let len = end.min(range.end).saturating_sub(offset.max(range.start));
+            if len > 0 {
+                let mut run = run.clone();
+                run.len = len;
+                runs.push(run);
+            }
+            offset = end;
+        }
+        let mut mappings = Vec::new();
+        if let Some(source_index) = source_index_for_rendered(&self.source_mappings, range.start) {
+            mappings.push(SourceMapping {
+                rendered_index: 0,
+                source_index,
+            });
+        }
+        mappings.extend(self.source_mappings.iter().filter_map(|mapping| {
+            (mapping.rendered_index > range.start && mapping.rendered_index < range.end).then_some(
+                SourceMapping {
+                    rendered_index: mapping.rendered_index.saturating_sub(range.start),
+                    source_index: mapping.source_index,
+                },
+            )
+        }));
+        Self {
+            text: self.text[range.clone()].to_owned(),
+            runs,
+            source_mappings: mappings,
+            source_end: if range.end == self.text.len() {
+                self.source_end
+            } else {
+                source_index_for_rendered(&self.source_mappings, range.end.saturating_sub(1))
+                    .map_or(self.source_end, |index| index + 1)
+            },
+            code_chips: self
+                .code_chips
+                .iter()
+                .filter_map(|(chip, color)| {
+                    let start = chip.start.max(range.start);
+                    let end = chip.end.min(range.end);
+                    (start < end).then_some((
+                        start.saturating_sub(range.start)..end.saturating_sub(range.start),
+                        *color,
+                    ))
+                })
+                .collect(),
+        }
+    }
+}
+
+impl MarkdownElementBuilder {
+    pub(super) fn push_block_sourced_element(
+        &mut self,
+        source_range: Range<usize>,
+        element: impl Into<AnyElement>,
+    ) {
+        self.flush_text();
+        let anchor = self.render_source_anchor(source_range);
+        self.append_child(
+            div()
+                .relative()
+                .w_full()
+                .flex_none()
+                .child(anchor)
+                .child(element.into())
+                .into_any_element(),
+        );
+    }
+
+    pub(super) fn push_inline_sourced_element(
+        &mut self,
+        source_range: Range<usize>,
+        element: impl Into<AnyElement>,
+    ) {
+        if let Some(mut entry) = self.div_stack.pop() {
+            entry.div = entry
+                .div
+                .flex()
+                .flex_row()
+                .flex_wrap()
+                .items_center()
+                .min_w_0()
+                .max_w_full();
+            entry.line_break_mode = LineBreakMode::InlineMath;
+            self.div_stack.push(entry);
+        }
+
+        // Keep opening punctuation with the formula, even when the line ends
+        // exactly between the parenthesis and its contents.
+        let opening_start = self
+            .pending_line
+            .text
+            .trim_end_matches(opens_inline_group)
+            .len();
+        let opening = self
+            .pending_line
+            .slice(opening_start..self.pending_line.text.len());
+        self.pending_line = self.pending_line.slice(0..opening_start);
+        self.flush_text();
+        let mut group = div()
+            .relative()
+            .flex()
+            .items_center()
+            .flex_none()
+            .min_w_0()
+            .max_w_full();
+        if !opening.text.is_empty() {
+            group = group.child(self.render_text_line(opening));
+        }
+        let anchor = self.render_source_anchor_with_text_style(source_range, self.text_style());
+        group = group.child(anchor).child(element.into());
+        if let Some(entry) = self.div_stack.last_mut() {
+            entry.pending_inline_math = Some(group.into());
+        }
+    }
+
+    pub(super) fn push_block_text(&mut self, text: &str, source_range: Range<usize>) {
+        self.flush_text();
+        self.div_stack
+            .push(DivStackEntry::new(div().w_full().flex_none()));
+        self.push_text(text, source_range);
+        self.pop_div();
+    }
+
+    pub(super) fn flush_inline_math_text(&mut self, mut line: PendingLine) {
+        if let Some(mut group) = self
+            .div_stack
+            .last_mut()
+            .and_then(|entry| entry.pending_inline_math.take())
+        {
+            let closing_end =
+                line.text.len() - line.text.trim_start_matches(closes_inline_group).len();
+            if closing_end > 0 {
+                group = group.child(self.render_text_line(line.slice(0..closing_end)));
+                line = line.slice(closing_end..line.text.len());
+            }
+            self.append_child(group.into_any_element());
+        }
+        for range in inline_text_ranges(&line.text) {
+            let is_break = &line.text[range.clone()] == "\n";
+            let element = self.render_text_line(line.slice(range));
+            let wrapper = div().min_w_0().max_w_full().flex_shrink_0();
+            self.append_child(if is_break {
+                wrapper
+                    .w_full()
+                    .h_0()
+                    .overflow_hidden()
+                    .child(element)
+                    .into_any_element()
+            } else {
+                wrapper.child(element).into_any_element()
+            });
+        }
+    }
+
+    pub(super) fn text_break_before(&mut self) -> bool {
+        if let Some(entry) = self.div_stack.last_mut()
+            && entry.line_break_mode == LineBreakMode::InlineMath
+        {
+            !mem::replace(&mut entry.inline_text_started, true)
+        } else {
+            true
+        }
+    }
+}
+
+impl RenderedText {
+    pub(super) fn logical_line_for_source_index(
+        &self,
+        source_index: usize,
+    ) -> Option<(Range<usize>, usize)> {
+        let selected = self
+            .lines
+            .iter()
+            .position(|line| source_index <= line.source_end)?;
+        let mut start = selected;
+        while start > 0 && !self.lines[start].break_before {
+            start -= 1;
+        }
+        let mut end = selected + 1;
+        while end < self.lines.len() && !self.lines[end].break_before {
+            end += 1;
+        }
+        Some((start..end, selected))
+    }
+
+    pub(super) fn surrounding_word_range_multi(&self, source_index: usize) -> Range<usize> {
+        if let Some((range, selected_index)) = self.logical_line_for_source_index(source_index) {
+            let lines = &self.lines[range];
+            let line = &self.lines[selected_index];
+            let mut rendered_index_in_line = 0;
+            let mut text = String::new();
+            for fragment in lines {
+                if Rc::ptr_eq(fragment, line) {
+                    let line_rendered_start =
+                        line.source_mappings.first().unwrap().rendered_index;
+                    let fragment_text = line.layout.text();
+                    rendered_index_in_line = text.len()
+                        + fragment_text.floor_char_boundary(
+                            line.rendered_index_for_source_index(source_index)
+                                .saturating_sub(line_rendered_start),
+                        );
+                }
+                text.push_str(&fragment.layout.text());
+            }
+            let scope = line
+                .language
+                .as_ref()
+                .map(|language| language.default_scope());
+            let classifier = CharClassifier::new(scope);
+
+            let mut prev_chars = text[..rendered_index_in_line].chars().rev().peekable();
+            let mut next_chars = text[rendered_index_in_line..].chars().peekable();
+
+            let word_kind = std::cmp::max(
+                prev_chars.peek().map(|&c| classifier.kind(c)),
+                next_chars.peek().map(|&c| classifier.kind(c)),
+            );
+
+            let mut start = rendered_index_in_line;
+            for c in prev_chars {
+                if Some(classifier.kind(c)) == word_kind {
+                    start -= c.len_utf8();
+                } else {
+                    break;
+                }
+            }
+
+            let mut end = rendered_index_in_line;
+            for c in next_chars {
+                if Some(classifier.kind(c)) == word_kind {
+                    end += c.len_utf8();
+                } else {
+                    break;
+                }
+            }
+
+            let source_for_offset = |mut offset: usize, exclusive: bool| {
+                for fragment in lines {
+                    let len = fragment.layout.len();
+                    if offset < len || (exclusive && offset == len) {
+                        let fragment_start = fragment
+                            .source_mappings
+                            .first()
+                            .map_or(0, |mapping| mapping.rendered_index);
+                        return if exclusive {
+                            fragment.source_index_for_exclusive_rendered_end(fragment_start + offset)
+                        } else {
+                            fragment.source_index_for_rendered_index(fragment_start + offset)
+                        };
+                    }
+                    offset -= len;
+                }
+                lines.last().map_or(source_index, |line| line.source_end)
+            };
+            return source_for_offset(start, false)..source_for_offset(end, true);
+        }
+
+        source_index..source_index
+    }
+
+    pub(super) fn surrounding_line_range_multi(&self, source_index: usize) -> Range<usize> {
+        if let Some((range, _)) = self.logical_line_for_source_index(source_index) {
+            let lines = &self.lines[range];
+            if let Some(first) = lines.first().and_then(|line| line.source_mappings.first())
+                && let Some(last) = lines.last()
+            {
+                return first.source_index..last.source_end;
+            }
+        }
+
+        source_index..source_index
+    }
+}
