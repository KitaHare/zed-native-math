+    assert_eq!(
+        rendered.surrounding_word_range(chinese + "继".len()),
+        chinese..chinese + "继续换行".len()
+    );
+    let index = source.find("换行。  ").expect("selection position");
+    assert_eq!(
+        rendered.source_index_for_utf16_index(rendered.utf16_index_for_source_index(index)),
+        index
+    );
+    assert!(
+        rendered
+            .lines
+            .iter()
+            .any(|line| !line.code_chips.is_empty()),
+        "inline code chips should survive text splitting"
+    );
+    let strong = rendered
+        .lines
+        .iter()
+        .find(|line| line.layout.text().as_str() == "加")
+        .expect("bold Chinese fragment");
+    assert_eq!(
+        strong.source_mappings[0].source_index,
+        source.find("加粗文字").expect("bold source")
+    );
+    let link = source.find("链接文字").expect("link source");
+    assert_eq!(
+        rendered
+            .link_for_source_index(link + "链".len())
+            .expect("link preserved")
+            .destination_url,
+        "https://example.com"
+    );
+}
