+fn test_inline_math_nested_lists_keep_block_layout_when_resized(cx: &mut TestAppContext) {
+    ensure_theme_initialized(cx);
+    for (marker, indent) in [("- ", "  "), ("1. ", "   "), ("- [ ] ", "  ")] {
+        let source = format!(
+            "{marker}于是引入松弛变量（Slack Variable） $\\xi_i$，允许部分样本打破“完美边界”：\n\
+             {indent}- 允许样本挤进原本干净的间隔带内部（$0 < \\xi_i < 1$）；\n\
+             {indent}- 甚至允许个别离群点直接被分错（$\\xi_i > 1$）。\n"
+        );
+        let parent_start = source.find("于是").expect("parent start");
+        let parent_end = source.find('：').expect("parent colon");
+        let first_start = source.find("允许样本挤进").expect("first child");
+        let first_end = source.find('；').expect("first child end");
+        let second_start = source.find("甚至允许").expect("second child");
+        let formula_start = source.find('$').expect("parent formula");
+        let rendered_text = Rc::new(RefCell::new(None));
+        let markdown = cx.new(|cx| {
+            Markdown::new_with_options(
+                source.clone().into(),
+                None,
+                None,
+                MarkdownOptions {
+                    render_mermaid_diagrams: true,
+                    ..Default::default()
+                },
+                cx,
+            )
+        });
+        cx.run_until_parked();
+        let (_, cx) = cx.add_window_view({
+            let rendered_text = rendered_text.clone();
+            move |_, _| MarkdownTestView {
+                markdown,
+                style: MarkdownStyle::default(),
+                code_span_link: None,
+                rendered_text,
+            }
+        });
+        for width in [1600., 900., 280., 1600.] {
+            cx.simulate_resize(size(px(width), px(1400.)));
+            cx.run_until_parked();
+            let rendered = rendered_text
+                .borrow()
+                .clone()
+                .expect("rendered nested list");
+            assert!(
+                rendered.lines.iter().any(|line| line
+                    .source_mappings
+                    .first()
+                    .is_some_and(|mapping| mapping.source_index == formula_start)
+                    && line.layout.text().as_str() == "\u{200B}"),
+                "test must exercise rendered math"
+            );
+            let (parent, _) = rendered
+                .position_for_source_index(parent_start)
+                .expect("parent position");
+            let (colon, height) = rendered
+                .position_for_source_index(parent_end)
+                .expect("colon position");
+            let (first, _) = rendered
+                .position_for_source_index(first_start)
+                .expect("child position");
+            let (first_last, child_height) = rendered
+                .position_for_source_index(first_end)
+                .expect("child end position");
+            let (second, _) = rendered
+                .position_for_source_index(second_start)
+                .expect("second child position");
+            assert!(
+                first.y + px(0.5) >= colon.y + height,
+                "nested list must start below its parent at width {width}, marker {marker:?}: parent {colon:?}, child {first:?}"
+            );
+            assert!(first.x > parent.x, "nested list should retain indentation");
+            assert!(
+                second.y + px(0.5) >= first_last.y + child_height,
+                "child items should stay vertically ordered"
+            );
+            for line in rendered.lines.iter() {
+                assert!(
+                    line.layout.bounds().right() <= px(width + 1.),
+                    "nested text must fit: {:?}",
+                    line.layout.bounds()
+                );
+            }
+        }
+    }
