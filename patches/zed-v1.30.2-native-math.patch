+                    .get(&new_y)
+                    .and_then(|cached| cached.fallback_image.as_ref())
+                    .map(|image| image.id),
+                Some(image_y.id)
+            );
+        });
+    }
+
+    #[gpui::test]
+    fn test_katex_no_fallback_on_add_in_middle(cx: &mut TestAppContext) {
