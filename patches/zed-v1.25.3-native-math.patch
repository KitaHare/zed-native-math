+fn inline_text_ranges(text: &str) -> Vec<Range<usize>> {
+    let mut ranges: Vec<Range<usize>> = Vec::new();
+    let mut start = 0;
+    for (index, word) in text.split_word_bound_indices() {
+        let end = index + word.len();
+        if word.chars().all(opens_inline_group) {
+            continue;
+        }
+        if start == index
+            && word != "\n"
+            && word
+                .chars()
+                .all(|character| character.is_whitespace() || closes_inline_group(character))
+            && let Some(previous) = ranges.last_mut()
+            && &text[previous.clone()] != "\n"
+        {
+            previous.end = end;
+        } else {
+            ranges.push(start..end);
+        }
+        start = end;
+    }
+    if start < text.len() {
+        ranges.push(start..text.len());
+    }
