+        let active_occurrences = active_diagrams
+            .iter()
+            .map(|diagram| super::KatexOccurrenceState {
+                source_start: diagram.source_range.start,
+                contents: diagram.contents.clone(),
+                mode: diagram.mode,
+                rendered_key: None,
