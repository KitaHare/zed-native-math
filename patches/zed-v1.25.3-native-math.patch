+fn math_delimiter_source(text: &str) -> Cow<'_, str> {
+    if !text.contains(r"\(") && !text.contains(r"\[") && !text.contains("$$") {
+        return Cow::Borrowed(text);
+    }
+
+    let mut protected = Parser::new_ext(text, PARSE_OPTIONS)
+        .into_offset_iter()
+        .filter_map(|(event, range)| match event {
+            pulldown_cmark::Event::Code(_)
+            | pulldown_cmark::Event::InlineMath(_)
+            | pulldown_cmark::Event::DisplayMath(_)
+            | pulldown_cmark::Event::Html(_)
+            | pulldown_cmark::Event::InlineHtml(_)
+            | pulldown_cmark::Event::Start(
+                pulldown_cmark::Tag::CodeBlock(_)
+                | pulldown_cmark::Tag::HtmlBlock
+                | pulldown_cmark::Tag::MetadataBlock(_)
+                | pulldown_cmark::Tag::Link { .. },
+            ) => Some(range),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    protected.sort_by_key(|range| range.start);
+
+    let bytes = text.as_bytes();
+    let mut normalized: Option<Vec<u8>> = None;
+    let mut index = 0;
+    let mut protected_index = 0;
+    while index + 1 < bytes.len() {
+        while protected
+            .get(protected_index)
+            .is_some_and(|range| range.end <= index)
+        {
+            protected_index += 1;
+        }
+        if let Some(range) = protected.get(protected_index)
+            && range.contains(&index)
+        {
+            index = range.end;
+            continue;
+        }
+        if bytes[index] != b'\\' {
+            index += 1;
+            continue;
+        }
+        let closing = match bytes[index + 1] {
+            b'(' => b')',
+            b'[' => b']',
+            _ => {
+                index += 2;
+                continue;
+            }
+        };
+        let mut end = index + 2;
+        let mut found = false;
+        while end + 1 < bytes.len() {
+            if bytes[end] == b'\\' {
+                if bytes[end + 1] == closing {
+                    // Equal-length substitutions preserve selection, copy, and link offsets.
+                    let output = normalized.get_or_insert_with(|| bytes.to_vec());
+                    output[index..index + 2].copy_from_slice(b"$$");
+                    output[end..end + 2].copy_from_slice(b"$$");
+                    index = end + 2;
+                    found = true;
+                    break;
+                }
+                end += 2;
+            } else {
+                end += 1;
+            }
+        }
+        if !found {
+            index += 2;
+        }
+    }
+    let mut index = 0;
+    let mut protected_index = 0;
+    while index + 1 < bytes.len() {
+        while protected
+            .get(protected_index)
+            .is_some_and(|range| range.end <= index)
+        {
+            protected_index += 1;
+        }
+        if let Some(range) = protected.get(protected_index)
+            && range.contains(&index)
+        {
+            index = range.end;
+            continue;
+        }
+        let current = normalized.as_deref().unwrap_or(bytes);
+        if current[index] == b'\\' {
+            index += 2;
+            continue;
+        }
+        if &current[index..index + 2] != b"$$" {
+            index += 1;
+            continue;
+        }
+        let start = index + 2;
+        let mut end = start;
+        while end + 1 < current.len() {
+            if current[end] == b'\\' {
+                end += 2;
+            } else if &current[end..end + 2] == b"$$" {
+                break;
+            } else {
+                end += 1;
+            }
+        }
+        if end + 1 >= current.len() {
+            index += 2;
+            continue;
+        }
+        // CommonMark finds setext headings before math spans. Shield their markers
+        // so a standalone `=` inside a formula cannot split it into separate blocks.
+        for offset in start..end {
+            if matches!(bytes[offset], b'=' | b'-') {
+                normalized.get_or_insert_with(|| bytes.to_vec())[offset] = b'x';
+            }
+        }
+        index = end + 2;
+    }
+    match normalized {
+        None => Cow::Borrowed(text),
+        Some(output) => match String::from_utf8(output) {
+            Ok(output) => Cow::Owned(output),
+            Err(error) => {
+                log::error!("Invalid UTF-8 while normalizing math delimiters: {error}");
+                Cow::Borrowed(text)
+            }
+        },
+    }
+}
+
+fn math_event_contents(
+    text: &str,
+    math_source: &str,
+    range: &Range<usize>,
+    delimiter_width: usize,
+    parsed: CowStr<'_>,
+) -> SharedString {
+    let content_range = range.start + delimiter_width..range.end - delimiter_width;
+    let original = &text[content_range.clone()];
+    let normalized = &math_source[content_range];
+    if original == normalized {
+        return parsed.into_string().into();
+    }
+
+    // The math parser removes list/blockquote prefixes after newlines. Restore
+    // shielded characters from the corresponding source suffix, keeping those
+    // prefixes out of the formula and preserving source offsets.
+    let mut original_lines = original.split_inclusive('\n');
+    let mut normalized_lines = normalized.split_inclusive('\n');
+    let mut restored = String::with_capacity(parsed.len());
+    for line in parsed.split_inclusive('\n') {
+        let Some((original_line, normalized_line)) =
+            original_lines.next().zip(normalized_lines.next())
+        else {
+            log::error!("Math source and parsed content have different line counts");
+            return parsed.into_string().into();
+        };
+        if !normalized_line.ends_with(line) {
+            log::error!("Math content does not match normalized source");
+            return parsed.into_string().into();
+        }
+        restored.push_str(&original_line[original_line.len() - line.len()..]);
+    }
+    restored.into()
+}
